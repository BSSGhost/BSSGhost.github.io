# Configuration MySQL de SUNU MOYENNE
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sunu_moyenne

# TLS MySQL (recommandé pour Aiven)
# DB_SSL=true
# DB_SSL_CA_PATH=certs/aiven-ca.pem
# Sur Render, DB_SSL_CA peut contenir le PEM complet.

# Optionnel
MIGRATION_TTL_HOURS=24
DB_CONNECTION_LIMIT=5

# URL publique du site (obligatoire en local pour que le lien/QR fonctionne sur un autre appareil)
# PUBLIC_URL=https://sunumoyenne.lynaqesedhiou.com

# Sessions administration
ADMIN_SESSION_HOURS=12

# Initialisation des administrateurs (uniquement sur base de TEST, mots de passe distincts)
# ADMIN_PRINCIPAL_INITIAL_PASSWORD=
# ADMIN_PEDAGOGICAL_INITIAL_PASSWORD=
